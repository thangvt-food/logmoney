# Firebase web app configuration (public client settings, not Admin SDK credentials).
VITE_FIREBASE_API_KEY=your-firebase-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_APP_ID=your-firebase-app-id

# Cloudflare Worker URL, for example https://logmoney-api.example.workers.dev
VITE_API_BASE_URL=

# Vite base path. GitHub Actions sets this automatically for GitHub Pages.
VITE_BASE_PATH=/
